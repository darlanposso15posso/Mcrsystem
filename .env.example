# ─── LLM Router ──────────────────────────────────────────────────────────────
# Pelo menos um provider de nuvem (Claude ou Gemini) deve ser configurado.
# O Ollama (local) é usado como fallback final e não precisa de chave.

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Limites diários de tokens por provider ───────────────────────────────────
# O roteador troca de provider automaticamente ao atingir o threshold (%).
# Ajuste conforme o seu plano:
#   Claude Free ≈ 100k tokens/dia | Claude Pro ≈ ilimitado (mas tem rate limit)
#   Gemini Free ≈ 1M tokens/dia   | Gemini Paid ≈ ilimitado
CLAUDE_DAILY_TOKEN_LIMIT=100000
CLAUDE_SWITCH_THRESHOLD=80

GEMINI_DAILY_TOKEN_LIMIT=1000000
GEMINI_SWITCH_THRESHOLD=85

# ─── Ollama (modelos locais) ───────────────────────────────────────────────────
# URL do servidor Ollama/LM Studio/Jan.ai rodando localmente
OLLAMA_BASE_URL=http://localhost:11434

# Modelos a usar por tipo de tarefa (devem estar baixados via `ollama pull`)
# Raciocínio/planejamento:
OLLAMA_PLANNING_MODEL=deepseek-r1:32b
OLLAMA_REASONING_MODEL=deepseek-r1:32b
# Código/execução:
OLLAMA_EXECUTION_MODEL=qwen2.5-coder:32b
# Tarefas simples (leve e rápido):
OLLAMA_SIMPLE_MODEL=llama3.2:3b

# ─── Modelos Claude por tarefa (opcional — sobrescreve os padrões) ────────────
# CLAUDE_PLANNING_MODEL=claude-opus-4-6
# CLAUDE_REASONING_MODEL=claude-opus-4-6
# CLAUDE_EXECUTION_MODEL=claude-sonnet-4-6
# CLAUDE_SIMPLE_MODEL=claude-haiku-4-5-20251001

# ─── Modelos Gemini por tarefa (opcional — sobrescreve os padrões) ────────────
# GEMINI_PLANNING_MODEL=gemini-2.5-pro
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# GEMINI_EXECUTION_MODEL=gemini-2.5-flash
# GEMINI_SIMPLE_MODEL=gemini-2.0-flash-lite

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="D&E Hood Cleaning <noreply@dehood.com>"
